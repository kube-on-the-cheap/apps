# Default garbage
**/.DS_Store
.vscode/*
.tmp/**

# Taskfile checksum ignores
.task/checksum/**

# env vars to govern the Control Plane access
.envrc

# Superpowers plans and specs are local-only artifacts
docs/superpowers/plans/
docs/superpowers/specs/

# Terragrunt
**/.terragrunt-cache
# Terraform
**/.terraform
**/*.tfstate
**/*.tfstate.backup
**/*.tfstate.*.backup
**/*.tfplan
**/*.tfvars
**/*.tfvars.json
**/*.auto.tfvars
# Terraform locks are useful only in root modules
configs/**/.terraform.lock.hcl
